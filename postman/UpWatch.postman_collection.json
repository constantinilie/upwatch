                  "    pm.expect(data).to.have.property(\"refresh\");",
                  "});",
                  "// Kept apart from {{access}}, so the other requests still run as the main client.",
                  "if (data.access) pm.environment.set(\"registered_access\", data.access);"
                ]
              }
