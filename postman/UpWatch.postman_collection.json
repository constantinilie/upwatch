{
  "info": {
    "_postman_id": "2fb47993-8d4d-4545-b601-48107594908e",
    "name": "UpWatch API",
    "description": "API-ul UpWatch pentru clienți (JWT).\n\n1. Importă și environment-ul **UpWatch Local** și selectează-l.\n2. Rulează **Auth / Login (client)** – salvează `access` și `refresh`.\n3. Celelalte request-uri folosesc automat `Bearer {{access}}`; când access token-ul expiră, scriptul colecției îl reîmprospătează cu `refresh`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const access = pm.environment.get(\"access\");",
          "const refresh = pm.environment.get(\"refresh\");",
          "const isTokenRequest = pm.request.url.toString().includes(\"/auth/token\");",
          "",
          "function expiresSoon(token) {",
          "    try {",
          "        let part = token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
          "        part += \"=\".repeat((4 - (part.length % 4)) % 4);",
          "        const payload = JSON.parse(atob(part));",
          "        return payload.exp * 1000 < Date.now() + 10000;",
          "    } catch (e) {",
          "        return false;",
          "    }",
          "}",
          "",
          "if (!isTokenRequest && access && refresh && expiresSoon(access)) {",
          "    pm.sendRequest({",
          "        url: pm.variables.replaceIn(\"{{base_url}}\") + \"/api/v1/auth/token/refresh/\",",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/json\" },",
          "        body: { mode: \"raw\", raw: JSON.stringify({ refresh: refresh }) }",
          "    }, (err, res) => {",
          "        if (!err && res.code === 200) {",
          "            pm.environment.set(\"access\", res.json().access);",
          "            console.log(\"Access token reîmprospătat automat.\");",
          "        } else {",
          "            console.warn(\"Refresh eșuat (refresh token expirat?). Rulează din nou Login (client).\");",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                ""
              ]
            },
            "description": "Login cu email + parolă. Salvează `access` și `refresh` în environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"{{client_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"primește access și refresh\", () => {",
                  "    pm.expect(data).to.have.property(\"access\");",
                  "    pm.expect(data).to.have.property(\"refresh\");",
                  "});",
                  "if (data.access) pm.environment.set(\"access\", data.access);",
                  "if (data.refresh) pm.environment.set(\"refresh\", data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Trimite refresh token-ul și primește un access token nou (salvat în environment).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"primește un access nou\", () => pm.expect(data).to.have.property(\"access\"));",
                  "if (data.access) pm.environment.set(\"access\", data.access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me",
                ""
              ]
            },
            "description": "Clientul autentificat și planul activ. Folosește Bearer {{access}} (moștenit din colecție)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"este clientul logat\", () => pm.expect(data.email).to.eql(pm.environment.get(\"client_email\")));",
                  "pm.test(\"are câmpul plan\", () => pm.expect(data).to.have.property(\"plan\"));"
                ]
              }
            }
          ]
        }
      ]
